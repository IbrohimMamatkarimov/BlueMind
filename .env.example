# Postgres connection string from Supabase: Project Settings > Database >
# Connection string > "Transaction" pooler mode (port 6543) — NOT the
# direct connection (port 5432). Serverless hosts like Vercel open many
# short-lived connections per request, and the pooler exists specifically
# to handle that without exhausting Supabase's connection limit.
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres"

# Server-side only — never exposed to the browser. Get one at https://console.groq.com/keys
GROQ_API_KEY="your-groq-api-key"

# Used to sign session cookies — set a long random string in production
SESSION_SECRET="change-me"

# Google Sign-In (Google Identity Services, ID-token flow — no client secret
# needed). Create an OAuth 2.0 Web application client at
# https://console.cloud.google.com/apis/credentials, add http://localhost:3000
# (and your production domain) as an Authorized JavaScript origin, then paste
# the Client ID below. Used both in the browser button and to verify tokens
# server-side, so only this one value is required.
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# Desmos graphing calculator for the Math section. Free API key at
# https://www.desmos.com/api — without this, the Math test still works, the
# calculator button just shows a short setup note instead of the calculator.
NEXT_PUBLIC_DESMOS_API_KEY="your-desmos-api-key"
